    "kwargs": {
      "record_transitions": false,
      "max_decisions": 8
    },
    "policy_factory": {
      "entrypoint": "q4_rl.network:load_policy",
      "kwargs": {
        "checkpoint": "results/q4_rl/training-smoke/latest.pt",
        "deterministic": true
      }
    },
    "artifact_files": [
      "results/q4_rl/training-smoke/latest.pt"
    ]
  }
}
