# Research manifests hash exact source/evidence bytes. Do not let a checkout
# silently change those bytes according to the host's core.autocrlf setting.
src/** -text
experiments/*.py -text
results/q3_optimization/** -text
results/q3_rollout/** -text
# Keep hashed Windows CRLF evidence byte-for-byte; CR is a line terminator.
results/q4_state_search/** -text whitespace=cr-at-eol
research/q4_state_search/** -text whitespace=cr-at-eol
results/q4_cover_search/** -text whitespace=cr-at-eol
research/q4_cover_search/** -text whitespace=cr-at-eol
research/q4_cover_candidates/** -text whitespace=cr-at-eol
results/q4_round2/** -text whitespace=cr-at-eol
research/q4_round2/** -text whitespace=cr-at-eol
experiments/q3_rollout*.json -text
results/study/** -text
results/validation/** -text
# Preserve historical terminal output, including progress CRs and final blanks.
results/study/console.txt -whitespace
results/validation/pytest.txt -whitespace
