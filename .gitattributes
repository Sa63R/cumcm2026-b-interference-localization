# Research manifests hash exact source/evidence bytes. Do not let a checkout
# silently change those bytes according to the host's core.autocrlf setting.
src/** -text
experiments/*.py -text
results/q3_optimization/** -text
results/q3_rollout/** -text
experiments/q3_rollout*.json -text
results/study/** -text
results/validation/** -text
# Preserve historical terminal output, including progress CRs and final blanks.
results/study/console.txt -whitespace
results/validation/pytest.txt -whitespace
# Round2 archives and their runner hashes must survive cross-platform checkout.
results/round2/** -text whitespace=cr-at-eol
research/round2/** -text whitespace=cr-at-eol
tests/test_round2_certified_tail_diagnosis.py -text
tests/test_round2_derived_silence*.py -text
tests/test_current_probe_prefix_audit.py -text
research/round2/diagnoses/BASELINE_OBSERVATION_COST.json whitespace=-blank-at-eof,cr-at-eol
results/round2/observation_tree/model_smoke/profile-top.txt -whitespace
research/round2/figures/*.svg -whitespace
