# Research manifests hash exact source/evidence bytes. Do not let a checkout
# silently change those bytes according to the host's core.autocrlf setting.
src/** -text
experiments/*.py -text
experiments/audit_q4_clear_before_probe_batch.py whitespace=cr-at-eol
results/q3_optimization/** -text
results/q3_rollout/** -text
# Keep hashed Windows CRLF evidence byte-for-byte; CR is a line terminator.
results/q4_state_search/** -text whitespace=cr-at-eol
research/q4_state_search/** -text whitespace=cr-at-eol
results/q4_cover_search/** -text whitespace=cr-at-eol
research/q4_cover_search/** -text whitespace=cr-at-eol
research/q4_cover_candidates/** -text whitespace=cr-at-eol
results/q4_round2/** -text whitespace=cr-at-eol
research/q4_round2/** -text whitespace=cr-at-eol
research/q4_shadow_archive/** -text whitespace=cr-at-eol
research/q4_joint/** -text whitespace=cr-at-eol
experiments/q3_rollout*.json -text
results/study/** -text
results/validation/** -text
# Preserve historical terminal output, including progress CRs and final blanks.
results/study/console.txt -whitespace
results/validation/pytest.txt -whitespace

research/q4_joint_archive/** -text whitespace=cr-at-eol

research/q4_optical_order_archive/** -text whitespace=cr-at-eol
results/q4_joint_visibility/** -text whitespace=cr-at-eol
research/q4_joint_visibility/** -text whitespace=cr-at-eol
results/q4_joint_continuation/** -text whitespace=cr-at-eol
research/q4_joint_continuation/** -text whitespace=cr-at-eol

# R34 byte-stable runtime and experiment records
.gitattributes -text
src/planning/matrix_chain_route.py -text
src/strategies/q4_known_source.py -text
experiments/*known_source*.py -text
experiments/run_q4_per_source.py -text
experiments/audit_q4_per_source.py -text
tests/*known_source*.py -text
tests/test_q4_per_source.py -text
research/q4_known_source/** -text whitespace=cr-at-eol
results/q4_known_source/** -text whitespace=cr-at-eol
