# Research manifests hash exact source/evidence bytes. Do not let a checkout
# silently change those bytes according to the host's core.autocrlf setting.
src/** -text
experiments/*.py -text
results/q3_optimization/** -text
results/q3_rollout/** -text
results/q3_fresh/** -text
results/q3_fresh_round2/** -text
research/q3_fresh_round2/*.json -text
experiments/q3_rollout*.json -text
results/study/** -text
results/validation/** -text
# Preserve historical terminal output, including progress CRs and final blanks.
results/study/console.txt -whitespace
results/validation/pytest.txt -whitespace
